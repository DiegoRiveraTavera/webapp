{
  "name": "webapp",
  "version": "1.2.0",
  "description": "API de inventario (Express + SQLite) con login, CRUD usuarios, pruebas unitarias/E2E y observabilidad OpenTelemetry/OpenObserve",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --verbose",
    "test:coverage": "jest --verbose --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-logs": "^0.55.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/jest.setup.js"],
    "testPathIgnorePatterns": ["<rootDir>/e2e/"],
    "collectCoverageFrom": ["src/app.js", "src/db.js", "src/auth.js"],
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": { "global": { "statements": 65, "branches": 65, "functions": 65, "lines": 65 } }
  }
}
